DAMEME_ENVIRONMENT=development
DAMEME_API_V1_PREFIX=/api/v1
DAMEME_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DAMEME_DATABASE_URL=sqlite:///./dameme.db
DAMEME_RECOMMENDATION_INDEX_DIR=../data/retrieval/memematch_281_indexes
DAMEME_RECOMMENDATION_METADATA_CSV=../data/retrieval/memematch_281/memematch_281_metadata.csv
# Existing local 281-image catalog. Keep this path relative to backend/ or use
# another verified local root; never point at the unavailable 1K catalog.
DAMEME_RECOMMENDATION_IMAGE_ROOT=../data/retrieval/memematch_281
DAMEME_RECOMMENDATION_REQUEST_TIMEOUT_SECONDS=15
# Keep model loading local-only; the required MiniLM checkpoint must already be cached.
HF_HUB_OFFLINE=1
# Active catalog: memematch_281 (default) or memematch_1000_v2.
# DAMEME_RECOMMENDATION_CATALOG=memematch_1000_v2
# DAMEME_RECOMMENDATION_CATALOG_ROOT=C:/DaMeme/data/retrieval/catalogs
# Optional, used only by retrieval_mode=hybrid_cross_encoder. The model must be
# cached explicitly; normal API requests never download it.
# DAMEME_RECOMMENDATION_CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
